FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-me-with-a-long-random-string
JWT_SECRET_KEY=replace-me-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
DATABASE_URL=sqlite:///fintrack_dev.db
FRAUD_LARGE_AMOUNT_THRESHOLD=10000.00
FRAUD_RAPID_TXN_COUNT=5
FRAUD_RAPID_TXN_WINDOW_MINUTES=10
FRAUD_PATTERN_DESTINATIONS=3
FRAUD_PATTERN_WINDOW_MINUTES=60
FRAUD_FAILED_ATTEMPTS_THRESHOLD=3
WORKER_MAX_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=5